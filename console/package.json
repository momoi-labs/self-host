{
  "name": "self-host-console",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "prototype": "vite --open '/console/?variant=A#new-dev-image'",
    "build": "tsc --noEmit && vite build && npm run keep",
    "typecheck": "tsc --noEmit",
    "keep": "node -e \"require('node:fs').writeFileSync('dist/.gitkeep','')\""
  },
  "dependencies": {
    "@momoi-labs/kiso-react": "^0.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
